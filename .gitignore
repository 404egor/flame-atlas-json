# dependencies and build output
node_modules/
.next/
dist/
out/
# test coverage reports; anchored, because the site has source folders named "coverage"
/coverage/
/apps/web/coverage/

# secrets: keys live only in .env.local and in the hosting provider's env
.env
.env.*
!.env.example

# local caches
.cache/
.turbo/
.vercel/

# OS and editor files
.DS_Store
.idea/
.vscode/

# archives and large downloads (role B extends this for data/raw documents)
*.zip
data/raw/**/*.pdf
data/raw/**/*.docx
data/raw/**/*.doc
data/raw/**/*.pptx
data/raw/**/*.ppt
data/raw/**/*.xlsx

# BMAD: personal install answers stay local; team config is committed
_bmad/config.user.toml
_bmad/custom/*.user.toml

# python
.venv/
__pycache__/
*.pyc
*.part

# generated document text/tables (122 MB, rebuilt by `python3 -m pipeline`)
data/extracted/

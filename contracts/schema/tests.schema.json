{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tests.schema.json",
  "title": "tests.json: unified table of PSI experiment rows",
  "type": "array",
  "items": { "$ref": "#/$defs/TestRecord" },
  "$defs": {
    "numOrNull": { "type": ["number", "null"] },
    "strOrNull": { "type": ["string", "null"] },
    "boolOrNull": { "type": ["boolean", "null"] },
    "TestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "investigationId", "tableFile", "sourceRow", "granularity", "label", "date",
        "fuelName", "fuelState", "fuelGeometry", "fuelRaw", "thicknessMm", "widthMm", "diameterMm",
        "o2PctMin", "o2PctMax", "o2PctValues", "o2PctApprox", "o2PctFinal", "diluent",
        "pressureKpaMin", "pressureKpaMax", "co2Pct",
        "flowCmSMin", "flowCmSMax", "flowDirection", "gravity",
        "ignited", "outcome", "burnTimeS", "spreadRateMmS", "coolFlame", "notes",
        "raw", "inferred", "confidence", "mappingVersion"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^PSI-[0-9]+:[^:]+:.+$", "description": "investigation:table:label-or-row, unique" },
        "investigationId": { "type": "string", "pattern": "^PSI-[0-9]+$" },
        "tableFile": { "type": "string", "description": "PSI file name of the experimental table" },
        "sourceRow": { "type": "integer", "minimum": 1, "description": "1-based data row in the source CSV" },
        "granularity": { "enum": ["test", "test-day", "matrix-row", "reference"] },
        "label": { "$ref": "#/$defs/strOrNull", "description": "test label as in the source" },
        "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "ISO date or null" },

        "fuelName": { "$ref": "#/$defs/strOrNull" },
        "fuelState": { "enum": ["solid", "liquid", "gas", "aerosol", null] },
        "fuelGeometry": { "$ref": "#/$defs/strOrNull", "description": "film, sheet, fabric, sphere, rod, droplet, burner ..." },
        "fuelRaw": { "$ref": "#/$defs/strOrNull", "description": "fuel cell exactly as in the source" },
        "thicknessMm": { "$ref": "#/$defs/numOrNull" },
        "widthMm": { "$ref": "#/$defs/numOrNull" },
        "diameterMm": { "$ref": "#/$defs/numOrNull" },

        "o2PctMin": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "initial O2, % by volume; single value: min = max" },
        "o2PctMax": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "o2PctValues": { "type": ["array", "null"], "items": { "type": "number", "minimum": 0, "maximum": 100 }, "description": "set when the source lists several values, e.g. 21; 26.5; 40" },
        "o2PctApprox": { "type": "boolean", "description": "true when the source marks the value as approximate (~)" },
        "o2PctFinal": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "diluent": { "$ref": "#/$defs/strOrNull", "description": "N2, CO2, He ..." },
        "pressureKpaMin": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "pressureKpaMax": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "co2Pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },

        "flowCmSMin": { "type": ["number", "null"], "minimum": 0 },
        "flowCmSMax": { "type": ["number", "null"], "minimum": 0 },
        "flowDirection": { "enum": ["opposed", "concurrent", "coflow", "quiescent", "unknown"] },
        "gravity": { "enum": ["micro", "normal", "partial-simulated"] },

        "ignited": { "$ref": "#/$defs/boolOrNull" },
        "outcome": { "enum": ["self-extinguished", "flow-terminated", "burned-out", "blowoff", "disruption", "not-ignited", "other", null] },
        "burnTimeS": { "type": ["number", "null"], "minimum": 0 },
        "spreadRateMmS": { "type": ["number", "null"], "minimum": 0 },
        "coolFlame": { "$ref": "#/$defs/boolOrNull" },
        "notes": { "$ref": "#/$defs/strOrNull" },

        "raw": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" }, "description": "all source columns, verbatim" },
        "inferred": { "type": "array", "items": { "type": "string" }, "description": "normalized fields NOT taken directly from a table column" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "mappingVersion": { "type": "string" }
      }
    }
  }
}
